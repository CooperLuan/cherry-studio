{
  "id": "fp-m2-apikey-dialog",
  "title": "API key 列表对话框 · 真 live CRUD（add/delete 即时反映）",
  "tier": "medium",
  "domain": "fileprocessing",
  "locale": "zh-CN",
  "source": "tests/e2e-agent/fileprocessing/cases/medium/FP-M2-apikey-dialog.yaml",
  "steps": [
    {
      "index": 1,
      "yaml": {
        "do": "goto",
        "nav": "settings"
      },
      "label": "goto-button[aria-label=\"设置\"]",
      "ok": true,
      "resolved": {
        "selector": "button[aria-label=\"设置\"]",
        "found": true,
        "ariaLabel": "设置"
      }
    },
    {
      "index": 2,
      "yaml": {
        "do": "click",
        "by": {
          "i18n": "settings.tool.file_processing.title"
        }
      },
      "label": "click-text=文档解析",
      "ok": true,
      "resolved": {
        "selector": "text=文档解析",
        "found": true,
        "text": "文档解析"
      }
    },
    {
      "index": 3,
      "yaml": {
        "do": "click",
        "by": {
          "id": "fp-item-document_to_markdown-mistral"
        }
      },
      "label": "click-css=#fp-item-document_to_markdown-mistral",
      "ok": true,
      "resolved": {
        "selector": "css=#fp-item-document_to_markdown-mistral",
        "found": true,
        "id": "fp-item-document_to_markdown-mistral"
      }
    },
    {
      "index": 4,
      "yaml": {
        "do": "click",
        "by": {
          "aria-i18n": "settings.provider.api.key.list.open"
        }
      },
      "label": "click-css=[aria-label=\"打开管理界面\"]",
      "ok": true,
      "resolved": {
        "selector": "css=[aria-label=\"打开管理界面\"]",
        "found": true,
        "ariaLabel": "打开管理界面"
      }
    },
    {
      "index": 5,
      "yaml": {
        "check": "visible",
        "by": {
          "i18n": "settings.provider.api.key.list.title"
        }
      },
      "label": "visible-text=API 密钥管理",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "text=API 密钥管理",
        "found": true,
        "text": "API 密钥管理"
      }
    },
    {
      "index": 6,
      "yaml": {
        "intent": "初始空列表（空态文案在场）",
        "check": "visible",
        "by": {
          "i18n": "error.no_api_key"
        }
      },
      "label": "visible-text=API 密钥未配置",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "text=API 密钥未配置",
        "found": true,
        "text": "API 密钥未配置"
      }
    },
    {
      "index": 7,
      "yaml": {
        "do": "click",
        "by": {
          "i18n": "common.add"
        }
      },
      "label": "click-button:has-text(\"添加\")",
      "ok": true,
      "resolved": {
        "selector": "button:has-text(\"添加\")",
        "found": true,
        "text": "添加"
      }
    },
    {
      "index": 8,
      "yaml": {
        "do": "type",
        "by": {
          "placeholder-i18n": "settings.provider.api.key.new_key.placeholder"
        },
        "text": "e2e-fake-key-001"
      },
      "label": "type-css=input[placeholder=\"输入 API 密钥\"]",
      "ok": true,
      "resolved": {
        "selector": "css=input[placeholder=\"输入 API 密钥\"]",
        "found": true,
        "placeholder": "输入 API 密钥"
      }
    },
    {
      "index": 9,
      "yaml": {
        "do": "click",
        "by": {
          "aria-i18n": "common.save"
        }
      },
      "label": "click-css=[aria-label=\"保存\"]",
      "ok": true,
      "resolved": {
        "selector": "css=[aria-label=\"保存\"]",
        "found": true,
        "ariaLabel": "保存"
      }
    },
    {
      "index": 10,
      "yaml": {
        "intent": "保存后 live +1（saved 行，编辑 input 消失）",
        "check": "count",
        "by": {
          "testid": "fp-apikey-row"
        },
        "equals": 1
      },
      "label": "count-css=[data-testid=\"fp-apikey-row\"]",
      "ok": true,
      "actual": {
        "count": 1
      },
      "resolved": {
        "selector": "css=[data-testid=\"fp-apikey-row\"]",
        "found": true,
        "testid": "fp-apikey-row"
      }
    },
    {
      "index": 11,
      "yaml": {
        "check": "hidden",
        "by": {
          "placeholder-i18n": "settings.provider.api.key.new_key.placeholder"
        }
      },
      "label": "hidden-css=input[placeholder=\"输入 API 密钥\"]",
      "ok": true,
      "actual": {
        "visibleCount": 0
      },
      "resolved": {
        "selector": "css=input[placeholder=\"输入 API 密钥\"]",
        "found": true,
        "placeholder": "输入 API 密钥"
      }
    },
    {
      "index": 12,
      "yaml": {
        "do": "click",
        "by": {
          "within": {
            "testid": "fp-apikey-row"
          },
          "aria-i18n": "common.delete"
        }
      },
      "label": "click-[data-testid=\"fp-apikey-row\"] [aria-label=\"删除\"]",
      "ok": true,
      "resolved": {
        "selector": "[data-testid=\"fp-apikey-row\"] [aria-label=\"删除\"]",
        "found": true,
        "ariaLabel": "删除",
        "within": {
          "selector": "css=[data-testid=\"fp-apikey-row\"]",
          "found": true,
          "testid": "fp-apikey-row"
        }
      }
    },
    {
      "index": 13,
      "yaml": {
        "intent": "确认删除（window.modal.confirm）",
        "do": "click",
        "by": {
          "i18n": "common.confirm"
        }
      },
      "label": "click-button:has-text(\"确认\")",
      "ok": true,
      "resolved": {
        "selector": "button:has-text(\"确认\")",
        "found": true,
        "text": "确认"
      }
    },
    {
      "index": 14,
      "yaml": {
        "intent": "删除后 live 归零（回空态，golden mistral 仍无 key）",
        "check": "visible",
        "by": {
          "i18n": "error.no_api_key"
        }
      },
      "label": "visible-text=API 密钥未配置",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "text=API 密钥未配置",
        "found": true,
        "text": "API 密钥未配置"
      }
    }
  ]
}
