{
  "id": "kb-m5-recall-execute",
  "title": "执行召回（信封）+ 历史 CRUD + 结果卡 copy/expand",
  "tier": "medium",
  "domain": "knowledge",
  "locale": "zh-CN",
  "source": "tests/e2e-agent/knowledge/cases/medium/M5-recall-execute.yaml",
  "steps": [
    {
      "index": 0,
      "yaml": {
        "intent": "开召回测试抽屉（DetailHeader FlaskConical）",
        "do": "click",
        "by": {
          "i18n": "knowledge.tabs.recall_test"
        }
      },
      "label": "open recall test panel",
      "ok": true,
      "resolved": {
        "selector": "[role=\"dialog\"]:has-text(\"召回测试\")",
        "found": true,
        "tag": "ASIDE",
        "role": "dialog",
        "ariaLabel": null,
        "dataSlot": "page-side-panel",
        "testid": null,
        "dataStatus": null,
        "text": "召回测试\n检索\n输入查询语句开始检索测试\n\n结果将展示匹配的文档片段和分数"
      }
    },
    {
      "index": 1,
      "yaml": {
        "do": "type",
        "by": {
          "placeholder-i18n": "knowledge.recall.placeholder"
        },
        "text": "${fixtures.recall-query}"
      },
      "label": "type recall query",
      "ok": true,
      "actual": {
        "typed": "${fixtures.recall-query}"
      },
      "resolved": {
        "selector": "input[placeholder=\"输入测试 Query...\"]",
        "found": true,
        "tag": "INPUT",
        "role": null,
        "ariaLabel": null,
        "dataSlot": "input",
        "testid": null,
        "dataStatus": null,
        "text": ""
      }
    },
    {
      "index": 2,
      "yaml": {
        "do": "click",
        "by": {
          "i18n": "knowledge.recall.submit"
        }
      },
      "label": "submit recall query",
      "ok": true,
      "resolved": {
        "selector": "button:has-text(\"检索\")",
        "found": true,
        "tag": "BUTTON",
        "role": null,
        "ariaLabel": null,
        "dataSlot": "button",
        "testid": null,
        "dataStatus": null,
        "text": "检索"
      }
    },
    {
      "index": 3,
      "yaml": {
        "intent": "searching 态（spinner + submit 禁用）",
        "check": "disabled",
        "by": {
          "i18n": "knowledge.recall.submit"
        }
      },
      "label": "submit disabled while searching",
      "ok": true,
      "actual": {
        "disabled": true
      },
      "resolved": {
        "selector": "button:has-text(\"检索\")",
        "found": true,
        "tag": "BUTTON",
        "role": null,
        "ariaLabel": null,
        "dataSlot": "button",
        "testid": null,
        "dataStatus": null,
        "text": "检索"
      }
    },
    {
      "index": 4,
      "yaml": {
        "intent": "摘要信封出现（计数文案在场即可，不断言取值）",
        "check": "visible",
        "by": {
          "i18n": "knowledge.recall.result_count"
        },
        "timeout": "60s"
      },
      "label": "result count envelope visible",
      "ok": true,
      "actual": {
        "visibleCount": 1,
        "text": "5 个结果"
      },
      "resolved": {
        "selector": "text=/\\d+ 个结果/",
        "found": true,
        "tag": "SPAN",
        "role": null,
        "ariaLabel": null,
        "dataSlot": null,
        "testid": null,
        "dataStatus": null,
        "text": "5 个结果"
      }
    },
    {
      "index": 5,
      "yaml": {
        "intent": "focus 输入 → 历史面板展开（query 已入首位）",
        "do": "click",
        "by": {
          "placeholder-i18n": "knowledge.recall.placeholder"
        }
      },
      "label": "open recall history",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "[data-recall-history]",
        "found": true,
        "tag": "DIV",
        "role": null,
        "ariaLabel": null,
        "dataSlot": null,
        "testid": null,
        "dataStatus": null,
        "text": "搜索历史\n清空\nThis sample document anchors the deterministic recall query for Cherry Studio knowledge tests.\nsecondary deterministic recall history entry"
      }
    },
    {
      "index": 6,
      "yaml": {
        "check": "visible",
        "by": {
          "has-attr": "data-recall-history"
        }
      },
      "label": "history container visible",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "[data-recall-history]",
        "found": true,
        "tag": "DIV",
        "role": null,
        "ariaLabel": null,
        "dataSlot": null,
        "testid": null,
        "dataStatus": null,
        "text": "搜索历史\n清空\nThis sample document anchors the deterministic recall query for Cherry Studio knowledge tests.\nsecondary deterministic recall history entry"
      }
    },
    {
      "index": 7,
      "yaml": {
        "check": "visible",
        "by": {
          "i18n": "knowledge.recall.history_title"
        }
      },
      "label": "history title visible",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "text=搜索历史",
        "found": true,
        "tag": "SPAN",
        "role": null,
        "ariaLabel": null,
        "dataSlot": null,
        "testid": null,
        "dataStatus": null,
        "text": "搜索历史"
      }
    },
    {
      "index": 8,
      "yaml": {
        "intent": "点历史项回填输入（不自动搜）",
        "do": "click",
        "by": {
          "within": {
            "has-attr": "data-recall-history"
          },
          "has-text": "${fixtures.recall-query}"
        }
      },
      "label": "select history item",
      "ok": true,
      "actual": {
        "inputValue": "${fixtures.recall-query}"
      },
      "resolved": {
        "selector": "[data-recall-history] .group\\/hist:has-text(\"${fixtures.recall-query}\")",
        "found": false,
        "error": "locator.elementHandle: Timeout 500ms exceeded.\nCall log:\n\u001b[2m  - waiting for locator('[data-recall-history]').locator('."
      }
    },
    {
      "index": 9,
      "yaml": {
        "intent": "hover 历史项让删除按钮可见",
        "do": "hover",
        "by": {
          "within": {
            "has-attr": "data-recall-history"
          },
          "has-text": "${fixtures.recall-query}"
        }
      },
      "label": "hover history item before remove",
      "ok": true,
      "resolved": {
        "selector": "[data-recall-history] .group\\/hist:has-text(\"${fixtures.recall-query}\")",
        "found": true,
        "tag": "DIV",
        "role": null,
        "ariaLabel": null,
        "dataSlot": null,
        "testid": null,
        "dataStatus": null,
        "text": "This sample document anchors the deterministic recall query for Cherry Studio knowledge tests."
      }
    },
    {
      "index": 10,
      "yaml": {
        "intent": "单项删除",
        "do": "click",
        "by": {
          "within": {
            "has-attr": "data-recall-history"
          },
          "aria-i18n": "knowledge.recall.history_remove"
        }
      },
      "label": "remove one history item",
      "ok": true,
      "actual": {
        "remainingTargetRows": 0
      },
      "resolved": {
        "selector": "[data-recall-history] .group\\/hist:has-text(\"${fixtures.recall-query}\") button[aria-label=\"删除历史\"]",
        "found": false,
        "error": "locator.elementHandle: Timeout 500ms exceeded.\nCall log:\n\u001b[2m  - waiting for locator('[data-recall-history]').locator('."
      }
    },
    {
      "index": 11,
      "yaml": {
        "intent": "清空历史",
        "do": "click",
        "by": {
          "aria-i18n": "knowledge.recall.history_clear"
        }
      },
      "label": "clear remaining history",
      "ok": true,
      "resolved": {
        "selector": "[data-recall-history] button:has-text(\"清空\")",
        "found": false,
        "error": "locator.elementHandle: Timeout 500ms exceeded.\nCall log:\n\u001b[2m  - waiting for getByRole('button', { name: '清空' }).first()"
      }
    },
    {
      "index": 12,
      "yaml": {
        "check": "hidden",
        "by": {
          "i18n": "knowledge.recall.history_title"
        }
      },
      "label": "history hidden after delete/clear",
      "ok": true,
      "actual": {
        "visibleCount": 0
      },
      "resolved": {
        "selector": "text=搜索历史",
        "found": false
      }
    },
    {
      "index": 13,
      "yaml": {
        "intent": "copy 图标 lucide-copy → lucide-check（成功态不 gate 颜色）",
        "do": "click",
        "by": {
          "aria-i18n": "knowledge.recall.copy"
        }
      },
      "label": "copy result card content",
      "ok": true,
      "actual": {
        "hadCopyIcon": 1,
        "hasCheckIcon": 1
      },
      "resolved": {
        "selector": ".group\\/chunk button[aria-label=\"复制片段\"]",
        "found": true,
        "tag": "BUTTON",
        "role": null,
        "ariaLabel": "复制片段",
        "dataSlot": "button",
        "testid": null,
        "dataStatus": null,
        "text": ""
      }
    },
    {
      "index": 14,
      "yaml": {
        "intent": "展开：p.line-clamp-2 → 无 clamp，按钮 aria expand → collapse",
        "do": "click",
        "by": {
          "aria-i18n": "knowledge.recall.expand"
        }
      },
      "label": "expand result card",
      "ok": true,
      "actual": {
        "hadClamp": true,
        "clampAfterExpand": false
      },
      "resolved": {
        "selector": ".group\\/chunk button[aria-label=\"收起片段\"]",
        "found": true,
        "tag": "BUTTON",
        "role": null,
        "ariaLabel": "收起片段",
        "dataSlot": "button",
        "testid": null,
        "dataStatus": null,
        "text": ""
      }
    },
    {
      "index": 15,
      "yaml": {
        "intent": "收起：无 clamp → p.line-clamp-2，按钮 aria collapse → expand",
        "do": "click",
        "by": {
          "aria-i18n": "knowledge.recall.collapse"
        }
      },
      "label": "collapse result card",
      "ok": true,
      "actual": {
        "clampAfterCollapse": true
      },
      "resolved": {
        "selector": ".group\\/chunk button[aria-label=\"展开片段\"]",
        "found": true,
        "tag": "BUTTON",
        "role": null,
        "ariaLabel": "展开片段",
        "dataSlot": "button",
        "testid": null,
        "dataStatus": null,
        "text": ""
      }
