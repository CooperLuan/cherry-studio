{
  "id": "kb-l2-add-file",
  "title": "加单个文件源（native picker via osascript）",
  "tier": "light",
  "domain": "knowledge",
  "locale": "zh-CN",
  "source": "tests/e2e-agent/knowledge/cases/light/L2-add-file.yaml",
  "steps": [
    {
      "index": 0,
      "yaml": {
        "intent": "打开数据源菜单（toolbar Add）",
        "do": "click",
        "by": {
          "i18n": "knowledge.data_source.toolbar.add"
        }
      },
      "label": "click button text=添加数据源",
      "ok": true,
      "resolved": {
        "selector": "button:has-text(\"添加数据源\")",
        "found": true,
        "tag": "BUTTON",
        "role": null,
        "ariaLabel": null,
        "dataSlot": "popover-trigger",
        "text": "添加数据源"
      }
    },
    {
      "index": 1,
      "yaml": {
        "intent": "选 file 源 → 立即弹原生 OS 文件框",
        "do": "click",
        "by": {
          "role": "menuitem",
          "i18n": "knowledge.data_source.add_dialog.sources.file"
        }
      },
      "label": "click text=文件",
      "ok": true,
      "resolved": {
        "selector": "text=文件",
        "found": true,
        "tag": "DIV",
        "role": "gridcell",
        "ariaLabel": null,
        "dataSlot": null,
        "text": "文件"
      }
    },
    {
      "index": 2,
      "yaml": {
        "intent": "用 osascript 在原生「打开」框喂入 fixture 绝对路径",
        "do": "shell",
        "osascript": "pick-file",
        "path": "${fixtures.sample-md}"
      },
      "label": "osascript pick-file",
      "ok": true,
      "actual": {
        "fixture": "sample-md",
        "nativeDialogTitle": "打开"
      },
      "resolved": {
        "selector": "macOS native open dialog",
        "found": true,
        "text": "sample.md"
      }
    },
    {
      "index": 3,
      "yaml": {
        "check": "count",
        "by": {
          "testid": "kb-item-row"
        },
        "min": 1
      },
      "label": "count [data-testid=\"kb-item-row\"] >= 1",
      "ok": true,
      "actual": {
        "count": 1,
        "min": 1
      },
      "resolved": {
        "selector": "[data-testid=\"kb-item-row\"]",
        "found": true,
        "visibleCount": 1
      }
    }
  ]
}
