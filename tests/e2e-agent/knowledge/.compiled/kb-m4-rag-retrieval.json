    {
      "index": 8,
      "yaml": {
        "intent": "searchMode=bm25 + 无 rerank → threshold 隐",
        "do": "select",
        "by": {
          "field-i18n": "knowledge.rag.search_mode.title"
        },
        "option": "bm25"
