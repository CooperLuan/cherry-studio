      "label": "select vector search mode",
      "ok": true,
      "resolved": {
        "selector": "button[role=\"combobox\"] -> [role=\"option\"]:has-text(\"向量检索\")",
        "found": true,
        "text": "向量检索"
      }
    },
    {
      "index": 3,
      "yaml": {
        "check": "visible",
        "by": {
          "aria-i18n": "knowledge.rag.threshold"
