      "yaml": {
        "intent": "documentCount slider 恒显",
        "check": "visible",
        "by": {
          "aria-i18n": "knowledge.rag.document_count"
        }
      },
      "label": "document count slider visible",
      "ok": true,
      "actual": {
        "visibleCount": 1
      },
      "resolved": {
        "selector": "[data-slot=\"slider\"][aria-label=\"请求文档片段数 (Top K)\"]",
        "found": true,
